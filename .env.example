# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MySQL connection string
DATABASE_URL="mysql://root:@localhost:3306/panvoya"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed script: creates one Admin account on first `npx prisma db seed`
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@panvoya.com"
SEED_ADMIN_PASSWORD="change-me-now"
